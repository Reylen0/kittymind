# LLM 配置（必填）
LLM_MODEL_ID=deepseek-chat          # 模型名，例如: deepseek-chat, gpt-4o, qwen-plus
LLM_API_KEY=your-api-key            # API Key
LLM_BASE_URL=https://api.deepseek.com/v1  # API 地址，OpenAI 兼容接口均可
LLM_TIMEOUT=60                      # 请求超时秒数，默认 60

# 辅助小模型（可选）：上下文压缩摘要 / 记忆提取 / 记忆召回筛选使用
# 留空 = 不启用，上述辅助任务回退主模型（主任务的推理与工具调用始终用主模型）
# LLM_AUX_MODEL_ID=qwen-turbo                 # 换成便宜快的小模型即可，例如 qwen-turbo / deepseek-chat
# LLM_AUX_API_KEY=your-aux-api-key            # 可选，不填则复用 LLM_API_KEY
# LLM_AUX_BASE_URL=https://api.deepseek.com/v1  # 可选，不填则复用 LLM_BASE_URL

# 记忆语义检索（可选）：配了就启用「向量 + 关键词融合」召回，
# 召回与提取去重不再随记忆条数变慢（记忆上百条后差别才明显）。
#
# ⚠️ 隐私提示：启用后会把**记忆正文**（每条截断到 300 字）发给下面的端点做向量化，
#    这是记忆内容第一次离开本机。不想外发就别配这段——召回会自动退回
#    「LLM 选序号 + 关键词」；也可在 settings.json 里写
#    {"MEMORY_RECALL_MODE": "keyword"} 强制零外发（只走本地 2-gram 关键词）。
# EMBEDDING_MODEL_ID=embedding-3                            # 任意 OpenAI 兼容的 embedding 模型
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # 智谱 / OpenAI / 兼容网关均可
# EMBEDDING_API_KEY=your-embedding-key
# EMBEDDING_DIM=512                                         # 0 = 用服务端默认维度

# WebSocket 服务端（可选，默认值已够用）
# WS_HOST=127.0.0.1
# WS_PORT=8765
