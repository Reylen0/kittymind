# LLM 配置（必填）
LLM_MODEL_ID=deepseek-chat          # 模型名，例如: deepseek-chat, gpt-4o, qwen-plus
LLM_API_KEY=your-api-key            # API Key
LLM_BASE_URL=https://api.deepseek.com/v1  # API 地址，OpenAI 兼容接口均可
LLM_TIMEOUT=60                      # 请求超时秒数，默认 60

# WebSocket 服务端（可选，默认值已够用）
# WS_HOST=127.0.0.1
# WS_PORT=8765
