# LLM 配置（必填）
LLM_MODEL_ID=your-model-id          # 例如: gpt-4o, deepseek-chat, qwen-plus
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60                      # 请求超时秒数，默认 60

# Embedding 配置（使用 RAG 功能时必填）
EMBEDDING_MODEL_ID=your-embedding-model-id   # 例如: text-embedding-3-small
EMBEDDING_API_KEY=your-embedding-api-key     # 可与 LLM_API_KEY 相同
EMBEDDING_BASE_URL=https://api.openai.com/v1 # 可与 LLM_BASE_URL 相同
