{
  "name": "kittymind",
  "version": "0.1.0",
  "description": "KittyMind — General Purpose Desktop Agent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "build:renderer": "vite build",
    "build:win": "pnpm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "canvas": "^3.2.3",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "electron": "^44.1.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.kittymind.desktop",
    "productName": "KittyMind",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload*.js",
      "renderer-dist/**/*",
      "src/pet/**/*",
      "src/overlay/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "../assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
